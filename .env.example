ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5

APP_ORIGIN=http://127.0.0.1:5173
API_ORIGIN=http://127.0.0.1:8787

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/oauth/google/callback

# Shopify Admin API — required only for "Create in Shopify Dev Store"
# Create a private app in your dev store Partners dashboard.
# Required scopes: read_products, write_products
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your-shopify-admin-access-token
SHOPIFY_API_VERSION=2026-01
